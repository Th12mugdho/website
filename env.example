# Copy this file to .env and fill in real values. Never commit .env itself.

# Required. Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — the model and how hard it thinks.
# Default is Claude Opus 5.5 at "low" effort (good for short chat answers).
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low

# Optional — protect your API bill.
# PER_MINUTE_LIMIT = messages one visitor can send per minute
# DAILY_LIMIT      = messages the whole site can send per day (UTC); after that the
#                    chat falls back to offline answers until tomorrow
PER_MINUTE_LIMIT=12
DAILY_LIMIT=300

# Set to 1 when running behind a hosting proxy (Render, Railway, Fly.io, nginx),
# so rate limits see each visitor's real IP instead of the proxy's.
TRUST_PROXY=1

# Only needed if the website is hosted somewhere ELSE than this server
# (comma-separated origins allowed to call /api/chat). Leave empty when
# server.js serves the site itself.
# ALLOWED_ORIGINS=https://www.bueec.com,https://bueec.com

# PORT=3000
