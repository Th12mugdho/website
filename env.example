# Copy this file to .env and fill in real values. Never commit .env itself.

# Get this from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Comma-separated list of origins allowed to call this backend.
# Use your real deployed site URL(s) once live, e.g.:
# ALLOWED_ORIGINS=https://www.bueec.com,https://bueec.com
ALLOWED_ORIGINS=http://localhost:5500
